{
    "name": "mudlet-map-diff",
    "version": "1.5.0",
    "keywords": [
        "mudlet",
        "map",
        "mud"
    ],
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "mudlet-map-diff": "dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./rendering": {
            "types": "./dist/rendering.d.ts",
            "import": "./dist/rendering.js"
        },
        "./svgs": {
            "types": "./dist/svgs.d.ts",
            "import": "./dist/svgs.js"
        }
    },
    "type": "module",
    "scripts": {
        "build": "tsc && shx cp -r src/templates dist/",
        "start": "node dist/example.js",
        "dev": "node --loader ts-node/esm src/example.ts",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/index.test.ts"
    },
    "repository": {
        "url": "git+https://github.com/Delwing/mudlet-map-diff.git"
    },
    "bugs": {
        "url": "https://github.com/Delwing/mudlet-map-diff/issues"
    },
    "homepage": "https://github.com/Delwing/mudlet-map-diff#readme",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "canvas": "^3.2.3",
        "commander": "^14.0.3",
        "listr2": "^10.2.1",
        "mudlet-map-binary-reader": "^2.0.0",
        "mudlet-map-renderer": "0.42.1-konva",
        "svgo": "^4.0.1"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^25.6.0",
        "@types/svgo": "^2.6.4",
        "jest": "^30.3.0",
        "shx": "^0.4.0",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    }
}
